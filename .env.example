# ===== 聊天模型 =====
# zhipu / deepseek / offline（offline 不调用任何外部模型，只做检索和抽取式回答）
RAG_LLM_PROVIDER=zhipu
RAG_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
RAG_LLM_MODEL=glm-4-flash
RAG_LLM_LIGHT_MODEL=glm-4-flash
RAG_LLM_TEMPERATURE=0.1
RAG_LLM_TIMEOUT=60

# 按 provider 填对应的 Key（只填一个即可）
ZHIPUAI_API_KEY=
DEEPSEEK_API_KEY=

# ===== 本地模型 =====
# BGE-M3 模型目录：相对项目根解析；也可以写绝对路径，例如 /path/to/BGE-M3
RAG_BGE_M3_PATH=BGE-M3
# auto / cuda / cpu
RAG_EMBED_DEVICE=auto
# float16 / bfloat16 / float32
RAG_EMBED_DTYPE=float16
RAG_EMBED_BATCH_SIZE=8
RAG_EMBED_MAX_LENGTH=1024
RAG_QUERY_MAX_LENGTH=256

# ===== 路径（相对项目根解析，不要写当前目录相对路径）=====
RAG_DOCS_DIR=docs
RAG_DATA_DIR=data
RAG_MILVUS_URI=data/milvus.db
RAG_MILVUS_COLLECTION=rag_chunks

# ===== 切分 =====
RAG_PARENT_SIZE=1200
RAG_CHILD_SIZE=350
RAG_CHUNK_OVERLAP=50

# ===== 检索 =====
RAG_TOP_K_DENSE=30
RAG_TOP_K_SPARSE=30
RAG_TOP_K_FINAL=6
RAG_RRF_K=60
RAG_MAX_CONTEXT_CHARS=6000

# ===== 日志 =====
RAG_LOG_LEVEL=INFO
